rules_version = '2';

// Regole di sicurezza di Frienzy. Principi (vedi docs/giorno-06-regole-sicurezza.md):
//  1. ognuno scrive solo il proprio profilo;
//  2. solo l'organizzatore modifica/annulla il suo evento;
//  3. chi si iscrive crea solo la propria partecipazione, con lo stato iniziale corretto;
//  4. solo l'organizzatore passa una richiesta a confermato/rifiutato;
//  5. il luogo esatto lo legge solo l'organizzatore o chi è confermato.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funzioni di aiuto ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Evento com'è ORA (prima della scrittura in corso).
    function eventNow(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // Evento com'è DOPO la scrittura in corso (serve per i batch che creano evento + luogo).
    function eventAfter(eventId) {
      return getAfter(/databases/$(database)/documents/events/$(eventId)).data;
    }

    // Posti occupati: events/{id}/contatori/posti.confermati (0 se il documento non c'è ancora).
    function seatsNow(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId)/contatori/posti;
      return exists(p) ? get(p).data.confermati : 0;
    }

    function seatsAfter(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId)/contatori/posti;
      return existsAfter(p) ? getAfter(p).data.confermati : 0;
    }

    // Lista d'attesa: events/{id}/contatori/attesa.coda (uid in ordine di arrivo; vuota se il documento non c'è).
    function queueNow(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId)/contatori/attesa;
      return exists(p) ? get(p).data.coda : [];
    }

    function queueAfter(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId)/contatori/attesa;
      return existsAfter(p) ? getAfter(p).data.coda : [];
    }

    // Nello stesso batch l'utente crea la propria partecipazione 'inAttesa' e si accoda (evento pieno).
    function joinsWaitlist(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId)/partecipanti/$(request.auth.uid);
      return !exists(p) && existsAfter(p) && getAfter(p).data.stato == 'inAttesa'
        && queueAfter(eventId) == queueNow(eventId).concat([request.auth.uid]);
    }

    // Nello stesso batch l'utente toglie la propria partecipazione 'inAttesa' e la sua voce dalla coda.
    function leavesWaitlist(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId)/partecipanti/$(request.auth.uid);
      return exists(p) && get(p).data.stato == 'inAttesa' && !existsAfter(p)
        && request.auth.uid in queueNow(eventId)
        && queueAfter(eventId).size() == queueNow(eventId).size() - 1
        && !(request.auth.uid in queueAfter(eventId));
    }

    // Un confermato si ritira e nello stesso batch il PRIMO della coda sale (coda accorciata di uno, in testa).
    // `stato` è quello atteso per il promosso: 'confermato' se l'evento è libero, 'richiesta' se serve l'approvazione.
    function promotesFirst(eventId) {
      let first = /databases/$(database)/documents/events/$(eventId)/partecipanti/$(queueNow(eventId)[0]);
      return queueNow(eventId).size() > 0
        && eventNow(eventId).stato == 'aperto'
        && get(first).data.stato == 'inAttesa'
        && getAfter(first).data.stato == (eventNow(eventId).richiedeApprovazione ? 'richiesta' : 'confermato')
        && queueAfter(eventId) == queueNow(eventId)[1:];
    }

    function isOrganizer(eventId) {
      return signedIn() && eventNow(eventId).organizzatoreId == request.auth.uid;
    }

    function isConfirmed(eventId) {
      let path = /databases/$(database)/documents/events/$(eventId)/partecipanti/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.stato == 'confermato';
    }

    // Nello stesso batch l'utente crea la propria partecipazione 'confermato' (non esisteva prima).
    function joinsConfirmed(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId)/partecipanti/$(request.auth.uid);
      return !exists(p) && existsAfter(p) && getAfter(p).data.stato == 'confermato';
    }

    // Nello stesso batch l'organizzatore porta una richiesta a 'confermato'.
    // Le regole non conoscono il uid del richiedente: basta che l'organizzatore sia chi scrive,
    // la regola di update della partecipazione verifica poi che la richiesta esistesse.
    function organizerAccepts(eventId) {
      return isOrganizer(eventId);
    }

    // Nello stesso batch l'utente toglie la propria partecipazione, che prima era 'confermato'.
    function withdrawsConfirmed(eventId) {
      let p = /databases/$(database)/documents/events/$(eventId)/partecipanti/$(request.auth.uid);
      return exists(p) && get(p).data.stato == 'confermato' && !existsAfter(p);
    }

    // Chi scrive si ritira da 'confermato' e nello stesso batch il primo della coda sale.
    function withdrawsConfirmedAndPromotes(eventId) {
      let me = /databases/$(database)/documents/events/$(eventId)/partecipanti/$(request.auth.uid);
      return exists(me) && get(me).data.stato == 'confermato' && !existsAfter(me) && promotesFirst(eventId);
    }

    // C'è un blocco tra le due persone (in un senso qualunque)? I documenti sono blocchi/{chi}_{chi}.
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/blocchi/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocchi/$(b + '_' + a));
    }

    function hasOnly(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    // ---------- profili ----------
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && hasOnly(request.resource.data,
             ['nome', 'dataNascita', 'bio', 'interessi', 'fotoUrl', 'creatoIl'])
        && validProfile(request.resource.data)
        && request.resource.data.creatoIl is timestamp;

      // Il creatoIl non si cambia mai.
      allow update: if isOwner(uid)
        && hasOnly(request.resource.data,
             ['nome', 'dataNascita', 'bio', 'interessi', 'fotoUrl', 'creatoIl'])
        && validProfile(request.resource.data)
        && request.resource.data.creatoIl == resource.data.creatoIl;

      // Eliminazione account: ognuno cancella solo il proprio profilo.
      allow delete: if isOwner(uid);

      // Notifiche: preferenze (4 interruttori) e dispositivo (token + zona di ~5 km). Privati del proprietario;
      // il server (Cloud Functions, con credenziali di amministrazione) li legge senza passare da qui.
      match /notifiche/preferenze {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasOnly(request.resource.data, ['promemoria', 'richieste', 'risposte', 'inviti'])
          && request.resource.data.promemoria is bool
          && request.resource.data.richieste is bool
          && request.resource.data.risposte is bool
          && request.resource.data.inviti is bool;
      }

      match /notifiche/dispositivo {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasOnly(request.resource.data, ['token', 'zona', 'aggiornatoIl'])
          && request.resource.data.token is string && request.resource.data.token.size() <= 1024
          && request.resource.data.zona is string && request.resource.data.zona.size() <= 5
          && request.resource.data.aggiornatoIl == request.time;
      }

      // Eventi salvati col cuore: privati, li vede e li scrive solo il proprietario.
      match /salvati/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasOnly(request.resource.data, ['eventId', 'creatoIl'])
          && request.resource.data.eventId == eventId
          && request.resource.data.creatoIl == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    function validProfile(d) {
      return d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 50
        && d.dataNascita is timestamp
        // 18 anni = 6575 giorni al massimo (con i bisestili): cautela di un giorno.
        && d.dataNascita <= request.time - duration.value(6575, 'd')
        && d.bio is string && d.bio.size() <= 300
        && d.interessi is list && d.interessi.size() <= 7
        && d.interessi.hasOnly(['aperitivo', 'cena', 'mostra', 'trekking', 'passeggiata', 'sport', 'altro'])
        && d.fotoUrl is string && d.fotoUrl.size() <= 2000;
    }

    // ---------- eventi ----------
    match /events/{eventId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && validNewEvent(request.resource.data);

      // Solo l'organizzatore; organizzatoreId e creatoIl restano quelli di prima.
      allow update: if isOrganizer(eventId)
        && request.resource.data.organizzatoreId == resource.data.organizzatoreId
        && request.resource.data.creatoIl == resource.data.creatoIl
        && validEventFields(request.resource.data);

      // Un evento non si cancella: si annulla (stato = 'annullato').
      allow delete: if false;

      // Luogo esatto: events/{id}/privato/luogo
      match /privato/{doc} {
        allow read: if isOrganizer(eventId) || isConfirmed(eventId);

        // Creato nello stesso batch dell'evento: si guarda l'evento "dopo" la scrittura.
        allow create: if signedIn()
          && doc == 'luogo'
          && eventAfter(eventId).organizzatoreId == request.auth.uid
          && validPlace(request.resource.data);

        allow update: if isOrganizer(eventId) && doc == 'luogo' && validPlace(request.resource.data);
        allow delete: if false;
      }

      // Contatore dei posti: sale di 1, mai oltre il massimo, in tre soli casi (sale o scende di 1):
      //  a) chi si iscrive a un evento libero (la propria iscrizione 'confermato' nasce nello stesso batch);
      //  b) l'organizzatore che accetta una richiesta (la richiesta passa a 'confermato' nello stesso batch).
      //  c) chi si ritira da confermato: il contatore scende di 1 (mai sotto zero) e la sua iscrizione sparisce nello stesso batch.
      match /contatori/{doc} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && doc == 'posti'
          && hasOnly(request.resource.data, ['confermati'])
          && request.resource.data.confermati is int
          && request.resource.data.confermati == seatsNow(eventId) + 1
          && request.resource.data.confermati <= eventNow(eventId).maxPartecipanti
          && (joinsConfirmed(eventId) || organizerAccepts(eventId));
        allow update: if signedIn()
          && doc == 'posti'
          && hasOnly(request.resource.data, ['confermati'])
          && request.resource.data.confermati is int
          && request.resource.data.confermati >= 0
          && request.resource.data.confermati == seatsNow(eventId) - 1
          && withdrawsConfirmed(eventId);
        // Coda d'attesa: cambia solo il campo `coda` (lista di uid), in tre casi, sempre insieme alla
        // partecipazione corrispondente nello stesso batch: mi accodo, esco dalla coda, il primo sale.
        allow create, update: if signedIn()
          && doc == 'attesa'
          && hasOnly(request.resource.data, ['coda'])
          && request.resource.data.coda is list
          && request.resource.data.coda.size() <= eventNow(eventId).maxPartecipanti * 10 + 50
          && (joinsWaitlist(eventId) || leavesWaitlist(eventId) || withdrawsConfirmedAndPromotes(eventId));
        allow delete: if false;
      }

      // Chat dell'evento: la leggono e ci scrivono solo l'organizzatore e i confermati (chi lascia l'evento perde l'accesso).
      // Il messaggio è di chi lo scrive, 1-500 caratteri, con data del server; non si modifica; lo cancella solo l'organizzatore.
      match /messaggi/{messageId} {
        allow read: if isOrganizer(eventId) || isConfirmed(eventId);
        allow create: if (isOrganizer(eventId) || isConfirmed(eventId))
          && eventNow(eventId).stato != 'annullato'
          && hasOnly(request.resource.data, ['authorUid', 'testo', 'creatoIl'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.testo is string
          && request.resource.data.testo.size() >= 1
          && request.resource.data.testo.size() <= 500
          && request.resource.data.creatoIl == request.time;
        allow update: if false;
        // Anche chi l'ha scritto può cancellare il proprio messaggio (serve all'eliminazione dell'account).
        allow delete: if isOrganizer(eventId) || (signedIn() && resource.data.authorUid == request.auth.uid);
      }

      // Partecipazioni: events/{id}/partecipanti/{uid}
      match /partecipanti/{uid} {
        // Si vedono: la propria, quelle di un evento che organizzi, e quelle già confermate.
        allow read: if isOwner(uid)
          || isOrganizer(eventId)
          || (signedIn() && resource.data.stato == 'confermato');

        // Chi si iscrive crea solo la propria, con lo stato iniziale deciso dall'evento.
        allow create: if isOwner(uid)
          && hasOnly(request.resource.data, ['eventId', 'uid', 'stato', 'creatoIl'])
          && request.resource.data.eventId == eventId
          && request.resource.data.uid == uid
          && request.resource.data.creatoIl is timestamp
          && eventNow(eventId).stato == 'aperto'
          && !blockedBetween(eventNow(eventId).organizzatoreId, uid)
          && (
               // Lista d'attesa: solo a evento pieno, con la coda aggiornata nello stesso batch.
               (request.resource.data.stato == 'inAttesa'
                 && seatsNow(eventId) >= eventNow(eventId).maxPartecipanti
                 && joinsWaitlist(eventId))
               || (request.resource.data.stato ==
                    (eventNow(eventId).richiedeApprovazione ? 'richiesta' : 'confermato')
                   // Un posto occupato = contatore +1 nello stesso batch/transazione, mai oltre il massimo.
                   && (request.resource.data.stato != 'confermato'
                       || (seatsAfter(eventId) == seatsNow(eventId) + 1
                           && seatsAfter(eventId) <= eventNow(eventId).maxPartecipanti)))
             );

        // Solo l'organizzatore decide, e solo su una richiesta; cambia soltanto lo stato.
        // Accettare occupa un posto: contatore +1 nello stesso batch, mai oltre il massimo.
        allow update: if isOrganizer(eventId)
          && resource.data.stato == 'richiesta'
          && request.resource.data.stato in ['confermato', 'rifiutato']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato'])
          && (request.resource.data.stato == 'rifiutato'
              || (eventNow(eventId).stato == 'aperto'
                  && seatsAfter(eventId) == seatsNow(eventId) + 1
                  && seatsAfter(eventId) <= eventNow(eventId).maxPartecipanti));

        // Promozione dalla lista d'attesa: la fa chi si ritira da confermato (nello stesso batch), solo sul primo della
        // coda; cambia soltanto lo stato. Se sale a 'confermato' il contatore resta com'è (uno esce, uno entra).
        allow update: if signedIn()
          && resource.data.stato == 'inAttesa'
          && uid == queueNow(eventId)[0]
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato'])
          && withdrawsConfirmedAndPromotes(eventId);

        // Ritiro: la propria partecipazione. Se era confermata libera un posto: contatore -1 nello stesso batch.
        // L'organizzatore può togliere solo richieste e rifiutati (non occupano posti).
        allow delete: if (isOwner(uid)
              && (resource.data.stato == 'inAttesa'
                  ? leavesWaitlist(eventId)
                  : (resource.data.stato != 'confermato'
                     || seatsAfter(eventId) == seatsNow(eventId) - 1
                     // oppure sale il primo della lista: i posti restano uguali se sale a 'confermato'
                     || (seatsAfter(eventId) == seatsNow(eventId) && promotesFirst(eventId)
                         && !eventNow(eventId).richiedeApprovazione))))
          || (isOrganizer(eventId) && resource.data.stato != 'confermato');
      }
    }

    // "Le mie iscrizioni": ricerca sulle sotto-raccolte "partecipanti" di tutti gli eventi.
    // Ognuno trova solo le proprie (il campo uid del documento deve essere il suo).
    match /{path=**}/partecipanti/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Blocchi: blocchi/{chi blocca}_{chi è bloccato}. Li legge solo chi è coinvolto (anche il bloccato: serve
    // all'app per nascondere gli eventi dell'altro). Li crea e li toglie solo chi blocca.
    match /blocchi/{id} {
      allow get: if signedIn() && (id.split('_')[0] == request.auth.uid || id.split('_')[1] == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if signedIn()
        && hasOnly(request.resource.data, ['blockerId', 'blockedId', 'creatoIl'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.blockedId
        && request.resource.data.creatoIl == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
    }

    // Segnalazioni: chiunque sia collegato ne crea, nessun utente le rilegge, modifica o cancella.
    match /segnalazioni/{id} {
      allow create: if signedIn()
        && hasOnly(request.resource.data, ['reporterUid', 'tipo', 'targetId', 'motivo', 'dettagli', 'creatoIl'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.tipo in ['evento', 'utente']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0 && request.resource.data.targetId.size() <= 128
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.motivo in ['spam', 'inappropriato', 'molestie', 'truffa', 'falso', 'altro']
        && request.resource.data.dettagli is string
        && request.resource.data.dettagli.size() <= 300
        && request.resource.data.creatoIl == request.time;
      allow read, update, delete: if false;
    }

    // ---------- presenze e voti (task 39) ----------
    // presenze/{evento}_{uid}: lo segna SOLO l'organizzatore, dopo l'inizio dell'evento, per un confermato.
    // Contiene solo "presente/assente": lo leggono tutti i collegati (serve al riepilogo del profilo).
    match /presenze/{pid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && hasOnly(request.resource.data, ['eventId', 'uid', 'organizzatoreId', 'stato', 'segnatoIl'])
        && request.resource.data.eventId is string && request.resource.data.uid is string
        && pid == request.resource.data.eventId + '_' + request.resource.data.uid
        && request.resource.data.organizzatoreId == request.auth.uid
        && eventNow(request.resource.data.eventId).organizzatoreId == request.auth.uid
        && eventNow(request.resource.data.eventId).stato != 'annullato'
        && request.time >= eventNow(request.resource.data.eventId).dataOra
        && request.resource.data.stato in ['presente', 'assente']
        && request.resource.data.segnatoIl == request.time
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)/partecipanti/$(request.resource.data.uid))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)/partecipanti/$(request.resource.data.uid)).data.stato == 'confermato';
      allow delete: if false;
    }

    // valutazioni/{evento}_{uid}: una sola per persona (solo create, mai update), dopo l'inizio dell'evento, da un confermato.
    // La leggono chi ha votato e l'organizzatore dell'evento.
    match /valutazioni/{vid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.organizzatoreId == request.auth.uid);
      allow create: if signedIn()
        && hasOnly(request.resource.data, ['eventId', 'uid', 'organizzatoreId', 'stelle', 'etichetta', 'creatoIl'])
        && request.resource.data.eventId is string
        && request.resource.data.uid == request.auth.uid
        && vid == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.organizzatoreId == eventNow(request.resource.data.eventId).organizzatoreId
        && request.resource.data.organizzatoreId != request.auth.uid
        && eventNow(request.resource.data.eventId).stato != 'annullato'
        && request.time >= eventNow(request.resource.data.eventId).dataOra
        && isConfirmed(request.resource.data.eventId)
        && request.resource.data.stelle is int && request.resource.data.stelle >= 1 && request.resource.data.stelle <= 5
        && request.resource.data.etichetta in ['', 'Simpatico', 'Ben organizzato', 'Puntuale', 'Accogliente', 'Da migliorare']
        && request.resource.data.creatoIl == request.time;
      allow update, delete: if false;
    }

    function validEventFields(d) {
      return d.tipo in ['aperitivo', 'cena', 'mostra', 'trekking', 'passeggiata', 'sport', 'altro']
        && d.titolo is string && d.titolo.size() >= 3 && d.titolo.size() <= 100
        && d.descrizione is string && d.descrizione.size() <= 1000
        && d.dataOra is timestamp
        && d.zonaNome is string && d.zonaNome.size() > 0 && d.zonaNome.size() <= 100
        && d.latApprossimata is number && d.lngApprossimata is number
        && d.geohash is string && d.geohash.size() > 0
        && d.maxPartecipanti is int && d.maxPartecipanti >= 1 && d.maxPartecipanti <= 200
        && d.richiedeApprovazione is bool
        && d.stato in ['aperto', 'chiuso', 'annullato'];
    }

    function validNewEvent(d) {
      return hasOnly(d, ['organizzatoreId', 'tipo', 'titolo', 'descrizione', 'dataOra', 'zonaNome',
                         'latApprossimata', 'lngApprossimata', 'geohash', 'maxPartecipanti',
                         'richiedeApprovazione', 'stato', 'creatoIl'])
        && d.organizzatoreId == request.auth.uid
        && d.stato == 'aperto'
        && d.creatoIl == request.time
        && validEventFields(d);
    }

    function validPlace(d) {
      return hasOnly(d, ['indirizzo', 'lat', 'lng'])
        && d.indirizzo is string && d.indirizzo.size() > 0 && d.indirizzo.size() <= 200
        && d.lat is number && d.lng is number;
    }
  }
}
