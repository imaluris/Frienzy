# Copia questo file in .env e sostituisci i valori con quelli del tuo progetto Firebase.
# I valori qui sotto sono FINTI: servono solo a far compilare l'app.
VITE_FIREBASE_API_KEY=finta-api-key
VITE_FIREBASE_AUTH_DOMAIN=frienzy-finto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=frienzy-finto
VITE_FIREBASE_STORAGE_BUCKET=frienzy-finto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
